# Gemini API Key (Get from: https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: AssemblyAI Key (Get from: https://www.assemblyai.com/)
# If not provided, app will use Google Speech-to-Text (free quota)
ASSEMBLY_AI_KEY=your_assembly_ai_key_here_optional

# Razorpay Keys (Get from: https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
